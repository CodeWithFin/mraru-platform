# Database (Neon Postgres via Drizzle). Without this, the app falls back to
# an in-process memory store — fine for a quick local look, but onboarding
# state will not survive a restart. Never use that fallback in production.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Signs onboarding resume tokens and role session tokens (see
# src/lib/auth/jwt-secret.ts). Set a real secret outside local dev.
JWT_SECRET=

# Queue/jobs (BullMQ). Without this, jobs fall back to a synchronous
# in-process queue — fine for local dev, not for production.
REDIS_URL=redis://127.0.0.1:6379

# Tilil SMS (OTP + notification checkpoints). Without an API key, SMS sends
# are logged instead of dispatched.
TILIL_SMS_API_KEY=
TILIL_SMS_SHORTCODE=MKASH
TILIL_SMS_SERVICE_ID=0

# ImageKit (profile photos, chama branding, constitution PDFs — never
# national ID images, those go through Didit only).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/mraru
# Client-side upload widget needs the public key/endpoint bundled in, so
# they're duplicated with the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/mraru

# Didit KYC (hosted ID + liveness + face match sessions). Without
# DIDIT_API_KEY, the integration runs in simulated demo mode
# (src/lib/integrations/didit.ts) — no real verification happens.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_BASE_URL=https://verification.didit.me/v3
